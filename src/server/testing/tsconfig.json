// Route-level regression tests: the REAL express routes, with @devvit/web/server swapped for a
// full in-memory redis stub. Needed because the two bugs of v0.0.7 (a solve reaching no board, and
// `opened` counting below `moved`) were invisible to every unit-level check - they only exist in
// the interaction between endpoints and the day a key is filed under.
//
//   npm run test:routes
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": "../../..",
    "paths": {
      "@devvit/web/server": ["./src/server/testing/devvit-stub.ts"],
      "@devvit/web/client": ["./node_modules/@devvit/web/client/index.d.ts"],
      "@devvit/client": ["./node_modules/@devvit/client/index.d.ts"]
    }
  },
  "include": ["./**/*", "../**/*", "../../shared/**/*"]
}
